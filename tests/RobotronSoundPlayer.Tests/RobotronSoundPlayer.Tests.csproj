<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xunit.v3 runs on Microsoft.Testing.Platform; `dotnet test` uses the MTP
       runner (global.json "test" section). No VSTest packages needed. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\RobotronSoundPlayer\RobotronSoundPlayer.csproj" />
  </ItemGroup>

  <!-- The ROM finder is shared with the game's tests rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Robotron2084.Tests\RomFiles.cs" Link="RomFiles.cs" />
  </ItemGroup>

</Project>
