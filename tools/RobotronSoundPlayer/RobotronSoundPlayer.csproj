<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>RobotronSoundPlayer</AssemblyName>
    <RootNamespace>RobotronSoundPlayer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The game supplies the sound tables and the sequencer, so the player asks for each sound
       exactly as the game does. MonoGame comes with it, and plays the sound on Windows and Linux. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Robotron2084\Robotron2084.csproj" />
  </ItemGroup>

</Project>
